{
    "instagram_container_create": {
        "method": "POST",
        "endpoint": "/{ig_user_id}/media",
        "authentication": "bearer",
        "request": {
            "image_url": "https://akiba.test/social/instagram.jpg",
            "caption": "Nova matéria na Rede Akiba #Akiba"
        },
        "response": {
            "id": "17890000000000001"
        }
    },
    "instagram_container_status": {
        "method": "GET",
        "endpoint": "/{container_id}",
        "authentication": "bearer",
        "request": {
            "fields": "status_code,status"
        },
        "response": {
            "id": "17890000000000001",
            "status_code": "FINISHED",
            "status": "Finished: Media has been uploaded and it is ready to be published."
        }
    },
    "facebook_photo_publish": {
        "method": "POST",
        "endpoint": "/{page_id}/photos",
        "authentication": "bearer",
        "request": {
            "url": "https://akiba.test/social/facebook.jpg",
            "message": "Nova matéria na Rede Akiba #Akiba"
        },
        "response": {
            "id": "100000000000001",
            "post_id": "100000000000000_200000000000001"
        }
    },
    "facebook_link_publish": {
        "method": "POST",
        "endpoint": "/{page_id}/feed",
        "authentication": "bearer",
        "request": {
            "message": "Nova matéria na Rede Akiba #Akiba",
            "link": "https://akiba.test/materia/nova-materia"
        },
        "response": {
            "id": "100000000000000_200000000000001"
        }
    },
    "instagram_media_publish": {
        "method": "POST",
        "endpoint": "/{ig_user_id}/media_publish",
        "authentication": "bearer",
        "request": {
            "creation_id": "17890000000000001"
        },
        "response": {
            "id": "17890000000000002"
        }
    }
}
